{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ],
  "packageRules": [
    {
      "description": "coredns/caddy v2 is not a drop-in for plugin API; wait for upstream coredns bump",
      "matchPackageNames": ["github.com/coredns/caddy"],
      "allowedVersions": "<2"
    },
    {
      "description": "Go major updates: separate PR per dependency",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["gomod-major"]
    },
    {
      "description": "Group Go minor and patch updates",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "go minor/patch",
      "groupSlug": "go-minor-patch"
    }
  ]
}